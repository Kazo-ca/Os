@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@using Kazo.Os.AppSdk.Storage

@if (_estimate is null)
{
    <p class="setting-desc" role="status">@L["Storage.Loading"]</p>
}
else if (!_estimate.IsKnown)
{
    <div class="setting-group storage-panel">
        <h4>@L["Storage.Title"]</h4>
        <p class="setting-desc">@L["Storage.Unknown"]</p>
    </div>
}
else
{
    <div class="setting-group storage-panel">
        <h4>@L["Storage.Title"]</h4>
        <p class="setting-desc">@L["Storage.Description"]</p>
        <meter class="storage-meter @(_estimate.IsLowSpace ? "is-low" : null)" min="0" max="100" low="80" high="90" optimum="0"
               value="@UsedPercent" aria-label="@L["Storage.UsageLabel"]"></meter>
        <p class="storage-usage-text">@L["Storage.Usage", FormatSize(_estimate.UsageBytes), FormatSize(_estimate.QuotaBytes), UsedPercent]</p>
        @if (_estimate.IsLowSpace)
        {
            <p class="storage-warning" role="alert">@L["Storage.LowSpace"]</p>
        }

        <dl class="storage-breakdown">
            <dt>@L["Storage.Part.Files"]</dt>
            <dd>@FormatOptional(_estimate.IndexedDbBytes)</dd>
            <dt>@L["Storage.Part.Caches"]</dt>
            <dd>@FormatOptional(_estimate.CacheBytes)</dd>
            <dt>@L["Storage.Part.Features"]</dt>
            <dd>@FormatOptional(_estimate.FileSystemBytes)</dd>
        </dl>
        @if (_estimate.IndexedDbBytes is null)
        {
            <p class="setting-desc">@L["Storage.NoDetail"]</p>
        }
    </div>

    <div class="setting-group storage-panel @(_estimate.IsPersisted ? null : "is-unprotected")">
        <h4>@L["Storage.Protection.Title"]</h4>
        @if (_estimate.IsPersisted)
        {
            <p class="storage-state is-protected" role="status">@L["Storage.Protection.On"]</p>
        }
        else
        {
            @if (_estimate.PersistenceLost)
            {
                <p class="storage-warning" role="alert">@L["Storage.Protection.Lost"]</p>
            }

            <p class="setting-desc">@L["Storage.Protection.Description"]</p>
            <button type="button" class="btn-secondary" disabled="@_requesting" @onclick="ProtectAsync">@L["Storage.Protection.Request"]</button>
            @if (_refused)
            {
                <p class="storage-warning" role="status">@L["Storage.Protection.Refused"]</p>
            }
        }
    </div>

    <div class="setting-group storage-panel">
        <h4>@L["Storage.Features.Title"]</h4>
        <p class="setting-desc">@L["Storage.Features.Description"]</p>
        @if (_features.Count == 0)
        {
            <p class="setting-desc">@L["Storage.Features.None"]</p>
        }
        else
        {
            <ul class="storage-features">
                @foreach (KazoFeatureStorageUsage feature in _features)
                {
                    <li key="@feature.FeatureId">
                        <span class="storage-feature-name">@feature.Name</span>
                        <code class="storage-feature-id">/dev/feature/@feature.FeatureId</code>
                        <span class="storage-feature-size">@(feature.UsageBytes is { } bytes ? FormatSize(bytes) : L["Storage.Features.Unknown"].Value)</span>
                    </li>
                }
            </ul>
        }
    </div>
}

@if (_error is not null)
{
    <p class="storage-warning" role="alert">@_error</p>
}
