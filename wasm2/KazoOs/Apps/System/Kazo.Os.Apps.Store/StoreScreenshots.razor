@using Kazo.Os.AppSdk.Icons
@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@*
    An app's screenshots on its Store page, and the viewer that shows one at the size of the Store
    window. Each thumbnail is a button: a click, Enter or Space opens it. In the viewer, the
    buttons, ← and →, Home and End, or a swipe move between the screenshots; Escape, the close button,
    a click beside the image or the OS's Back closes it, and the focus goes back to the thumbnail.
*@
@* ADR 0266 §8: on a phone the portrait screenshots come first (StoreScreenshotOrder); Shown is the
   strip's order, and the viewer moves in that same order. *@
<ul class="store-screenshots" aria-label="@Text["Detail.Screenshots"]" @ref="_strip">
    @for (int i = 0; i < Shown.Count; i++)
    {
        int index = i;
        <li class="@(IsPortraitAt(index) ? "is-portrait" : null)">
            <button type="button"
                    class="store-screenshot-thumb"
                    aria-label="@Text["Viewer.OpenScreenshot", index + 1, Shown.Count, AppName]"
                    aria-haspopup="dialog"
                    data-index="@index"
                    @ref="_thumbnails[index]"
                    @onclick="() => OpenAsync(index)">
                <img src="@Shown[index]" alt="" loading="lazy" draggable="false" />
            </button>
        </li>
    }
</ul>

@if (_state.Index is int current && current < Shown.Count)
{
    <div class="store-viewer"
         role="dialog"
         aria-modal="true"
         aria-label="@Text["Viewer.Label", AppName]"
         tabindex="-1"
         @ref="_dialog"
         @onkeydown="OnKeyDownAsync">
        <span class="store-viewer-edge" tabindex="0" aria-hidden="true" @onfocus="FocusLastAsync"></span>
        <div class="store-viewer-bar">
            <span class="store-viewer-position" aria-live="polite">@Text["Viewer.Position", current + 1, Shown.Count]</span>
            <button type="button"
                    class="store-viewer-button store-viewer-close"
                    aria-label="@Text["Viewer.Close"]"
                    title="@Text["Viewer.Close"]"
                    @ref="_closeButton"
                    @onclick="CloseAsync">
                <KazoIcon Library="IconLibrary.Lucide" Name="x" Size="20" Title="" />
            </button>
        </div>
        <div class="store-viewer-stage"
             @onclick="OnStageClickAsync"
             @onpointerdown="OnPointerDown"
             @onpointerup="OnPointerUpAsync"
             @onpointercancel="OnPointerCancel">
            <button type="button"
                    class="store-viewer-button store-viewer-previous"
                    aria-label="@Text["Viewer.Previous"]"
                    title="@Text["Viewer.Previous"]"
                    disabled="@(!_state.HasPrevious)"
                    @onclick="PreviousAsync"
                    @onclick:stopPropagation="true">
                <KazoIcon Library="IconLibrary.Lucide" Name="chevron-left" Size="28" Title="" />
            </button>
            <img class="store-viewer-image"
                 src="@Shown[current]"
                 alt="@Text["Viewer.Screenshot", current + 1, Shown.Count, AppName]"
                 draggable="false"
                 @onclick:stopPropagation="true" />
            <button type="button"
                    class="store-viewer-button store-viewer-next"
                    aria-label="@Text["Viewer.Next"]"
                    title="@Text["Viewer.Next"]"
                    disabled="@(!_state.HasNext)"
                    @ref="_nextButton"
                    @onclick="NextAsync"
                    @onclick:stopPropagation="true">
                <KazoIcon Library="IconLibrary.Lucide" Name="chevron-right" Size="28" Title="" />
            </button>
        </div>
        <span class="store-viewer-edge" tabindex="0" aria-hidden="true" @onfocus="FocusFirstAsync"></span>
    </div>
}
