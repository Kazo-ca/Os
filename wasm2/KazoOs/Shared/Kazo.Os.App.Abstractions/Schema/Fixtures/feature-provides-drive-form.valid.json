{
  "schemaVersion": 1,
  "id": "ca.example.pcloud",
  "name": "pCloud drives",
  "version": "1.0.0",
  "publisherId": "ca.example",
  "description": "Provides pCloud storage as network drives (ADR 0282).",
  "kind": "feature",
  "sdkCompatibility": {
    "minimumVersion": "3.2.0"
  },
  "presentation": {
    "category": "system",
    "launchVisibility": "hidden",
    "iconAssetPaths": []
  },
  "capabilities": [
    "drives.provide"
  ],
  "resources": {
    "baselineCpuWeight": 0.0,
    "burstCpuWeight": 0.0,
    "baselineMemoryWeight": 0.0,
    "burstMemoryWeight": 0.0,
    "baselineStorageIoWeight": 0.0,
    "burstStorageIoWeight": 0.0,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  },
  "execution": "mainThread",
  "driveProviders": [
    {
      "type": "webdav",
      "name": "WebDAV",
      "provider": "Webdav.WebdavDriveProvider, Webdav",
      "hosts": [
        "*.example.org"
      ],
      "connection": {
        "kind": "form",
        "fields": [
          {
            "name": "address",
            "label": "Address",
            "kind": "url",
            "secret": false,
            "required": true
          },
          {
            "name": "password",
            "label": "Password",
            "kind": "text",
            "secret": true,
            "required": true
          },
          {
            "name": "mode",
            "label": "Mode",
            "kind": "choice",
            "secret": false,
            "required": false,
            "default": "path",
            "choices": [
              "path",
              "virtual"
            ]
          }
        ]
      }
    }
  ]
}
