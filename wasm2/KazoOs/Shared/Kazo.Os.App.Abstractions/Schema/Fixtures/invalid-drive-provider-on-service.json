{
  "schemaVersion": 1,
  "id": "org.kazoos.notification-daemon",
  "name": "Notification Daemon",
  "version": "2.1.0",
  "publisherId": "org.kazoos",
  "description": "Background service that dispatches OS notifications to subscribed apps.",
  "kind": "service",
  "entryPoint": {
    "assembly": "Kazo.Os.Services.NotificationDaemon",
    "type": "Kazo.Os.Services.NotificationDaemon.NotificationDaemonService"
  },
  "sdkCompatibility": {
    "minimumVersion": "1.0.0"
  },
  "presentation": {
    "category": "system",
    "launchVisibility": "hidden",
    "iconAssetPaths": []
  },
  "capabilities": [
    "notifications.publish"
  ],
  "resources": {
    "baselineCpuWeight": 0.02,
    "burstCpuWeight": 0.08,
    "baselineMemoryWeight": 0.03,
    "burstMemoryWeight": 0.06,
    "baselineStorageIoWeight": 0.0,
    "burstStorageIoWeight": 0.01,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  },
  "singleInstancePerUser": true,
  "autoStart": true,
  "driveProviders": [
    {
      "type": "webdav",
      "name": "WebDAV",
      "provider": "Webdav.WebdavDriveProvider, Webdav",
      "hosts": [
        "*.example.org"
      ],
      "connection": {
        "kind": "form",
        "fields": [
          {
            "name": "address",
            "label": "Address",
            "kind": "url",
            "secret": false,
            "required": true
          },
          {
            "name": "password",
            "label": "Password",
            "kind": "text",
            "secret": true,
            "required": true
          },
          {
            "name": "mode",
            "label": "Mode",
            "kind": "choice",
            "secret": false,
            "required": false,
            "default": "path",
            "choices": [
              "path",
              "virtual"
            ]
          }
        ]
      }
    }
  ]
}
