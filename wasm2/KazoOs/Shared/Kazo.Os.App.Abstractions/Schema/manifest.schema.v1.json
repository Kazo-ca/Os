{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazoos.org/schema/app-manifest/1/manifest.schema.json",
  "title": "Kazo OS Application Manifest",
  "description": "Canonical app.manifest.json schema, per ADR 0010. Schema version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisherId",
    "description",
    "kind",
    "sdkCompatibility",
    "presentation",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "publisherId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["window", "terminal", "service", "web", "feature"] },
    "parent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$" },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly", "type"],
      "properties": {
        "assembly": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "entryPoints"],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platformId" }
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platforms", "assembly", "type"],
            "properties": {
              "platforms": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/platformId" }
              },
              "assembly": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sdkCompatibility": { "$ref": "#/$defs/versionRange" },
    "osCompatibility": { "$ref": "#/$defs/versionRange" },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "launchVisibility", "iconAssetPaths"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "launchVisibility": { "enum": ["visible", "hidden"] },
        "iconAssetPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRelativePath" }
        }
      }
    },
    "localizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["culture", "resourcePath"],
        "properties": {
          "culture": { "type": "string", "minLength": 1 },
          "resourcePath": { "$ref": "#/$defs/packageRelativePath" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "realNetworkPorts": {
      "description": "Real-network ports the app needs through the server's relay (ADR 0235): 'tcp/6697' or 'udp/5353'. Requires the network.real.access capability. Omitted: none beyond the relay's AllowedPorts.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:[tT][cC][pP]|[uU][dD][pP])/[1-9][0-9]{0,4}$" }
    },
    "directNetworkHosts": {
      "description": "Web hosts the app reaches directly through the browser's fetch, without the Kazo server (ADR 0282): an exact host name ('api.example.com') or a subdomain wildcard ('*.example.com'), always over https. Requires the network.direct.access capability. Omitted: no direct request.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:\\*\\.)?[^*/:@?#\\s\\[\\]]+\\.[^*/:@?#\\s\\[\\]]+$" }
    },
    "declaredTopicPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(topic-publish|topic-subscribe):app/[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}/[a-z0-9-]+(/[a-z0-9-]+)*$"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resources": { "$ref": "#/$defs/resourceProfile" },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "fields"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "migrationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "valueType", "defaultValue", "scope", "sensitivity"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "valueType": { "enum": ["string", "integer", "boolean", "enum"] },
              "defaultValue": { "type": "string" },
              "scope": { "enum": ["appUser", "appDevice", "appUserDevice", "appRoamingUser", "osAdmin"] },
              "sensitivity": { "enum": ["public", "private", "secretReference", "restricted"] },
              "allowedValues": { "type": "array", "items": { "type": "string" } },
              "group": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "required": ["valueType"],
                  "properties": { "valueType": { "const": "enum" } }
                },
                "then": { "required": ["allowedValues"] }
              }
            ]
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {
          "intentId": { "type": "string", "minLength": 1 },
          "payloadSchemaAssetPath": { "$ref": "#/$defs/packageRelativePath" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "minimumVersion"],
        "properties": {
          "appId": { "type": "string", "minLength": 1 },
          "minimumVersion": { "$ref": "#/$defs/semanticVersion" },
          "maximumVersion": { "$ref": "#/$defs/semanticVersion" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/packageRelativePath" },
          "kind": { "enum": ["image", "css", "javaScriptModule", "localization", "data"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationIds"],
      "properties": {
        "migrationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "minimumUpgradableVersion": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "fileHandlers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensions", "actions"],
        "properties": {
          "mediaType": { "type": "string", "minLength": 1 },
          "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } },
          "actions": { "type": "array", "items": { "enum": ["open", "edit"] } },
          "priority": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "aliases", "usage"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
        "usage": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "assembly", "type"],
        "properties": {
          "contract": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$" },
          "assembly": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "providedServices": {
      "description": "Services a feature provides to other apps (ADR 0262 §1): a contract, an interface of a shared library, and the type that implements it, both written 'Full.Type.Name, Assembly'. Only a feature declares them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "implementation"],
        "properties": {
          "contract": { "type": "string", "pattern": "^[^,\\s]+, *[^,\\s=/\\\\]+$" },
          "implementation": { "type": "string", "pattern": "^[^,\\s]+, *[^,\\s=/\\\\]+$" },
          "entryPoint": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){3,}$" }
        }
      }
    },
    "driveProviders": {
      "description": "Types of network drive a feature provides (ADR 0282 §1): the filesystem type, the service's name, the class deriving from KazoDriveProvider written 'Full.Type.Name, Assembly', how the user connects (oauth or form) and the hosts the class reaches over https. Only a feature declares them, with the capability drives.provide.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "provider", "connection"],
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "not": { "enum": ["hostfs", "dropbox", "onedrive", "s3", "idbfs", "proc", "procfs", "devfs", "sysfs", "devtmpfs", "tmpfs", "ramfs", "devpts", "cgroup", "cgroup2", "overlay", "squashfs", "fuse", "nfs", "nfs4", "cifs", "smb", "smb3", "ext2", "ext3", "ext4", "btrfs", "xfs", "vfat", "exfat", "ntfs", "iso9660", "none"] }
          },
          "name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "pattern": "^[^,\\s]+, *[^,\\s=/\\\\]+$" },
          "icon": { "type": "string", "minLength": 1 },
          "hosts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" }
          },
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["oauth", "form"] },
              "oauth": { "$ref": "#/$defs/driveOAuth" },
              "fields": { "type": "array", "items": { "$ref": "#/$defs/driveFormField" } }
            },
            "oneOf": [
              { "properties": { "kind": { "const": "oauth" } }, "required": ["oauth"] },
              { "properties": { "kind": { "const": "form" }, "fields": { "minItems": 1 } }, "required": ["fields"], "not": { "required": ["oauth"] } }
            ]
          }
        }
      }
    },
    "capabilityPrefix": {
      "description": "Prefix of the permissions a feature declares (ADR 0246 §2): one lowercase segment no built-in capability uses.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "providedCapabilities": {
      "description": "Permissions a feature declares (ADR 0246 §1), each '<prefix>.<name>', normal or dangerous, with the same rules as the built-in catalog.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
          "risk": { "enum": ["normal", "dangerous"] },
          "title": { "type": "string", "minLength": 1 },
          "riskStatement": { "type": "string", "minLength": 1 },
          "covers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "roles": {
      "description": "Roles a feature declares (ADR 0247 §1), each '<prefix>:<name>' under its own prefix (ADR 0283): an administrator grants one to an ordinary user; every administrator holds them all.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "grants": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "requiresRole": {
      "description": "Role of its feature a user must hold to see and launch this entry point (ADR 0247 §2).",
      "type": "string",
      "minLength": 1
    },
    "contextMenus": {
      "description": "Entries the app adds to the OS file menus (ADR 0151, ADR 0159), in declaration order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "titles", "target", "scopes", "selection", "first"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "titles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["culture", "text"],
              "properties": {
                "culture": { "type": "string", "minLength": 2 },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "target": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "icon": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source"],
            "properties": {
              "kind": { "enum": ["vector", "image"] },
              "source": { "type": "string", "minLength": 1 },
              "library": { "enum": ["bootstrap", "fontawesome", "lucide", "simpleicons"] }
            }
          },
          "scopes": { "type": "array", "minItems": 1, "items": { "enum": ["file", "directory", "background", "desktop"] } },
          "types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "selection": { "enum": ["all", "each", "single"] },
          "first": { "type": "boolean" },
          "after": { "type": "string", "minLength": 1 },
          "afterGroup": { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "minLength": 1 },
          "screens": { "description": "ADR 0218: shown only with one open screen, or with two or more.", "enum": ["single", "multiple"] },
          "screen": { "description": "ADR 0218: shown only while this secondary screen is open.", "type": "integer", "minimum": 2, "maximum": 9 }
        }
      }
    },
    "singleInstancePerUser": { "type": "boolean" },
    "autoStart": { "type": "boolean" },
    "serviceStartup": {
      "description": "When an automatic service starts (ADR 0097): after a login (default) or at boot (system apps only).",
      "enum": ["login", "boot"]
    },
    "supportsBack": { "type": "boolean" },
    "window": {
      "description": "Window sizes of a window app in CSS pixels (ADR 0095 §2). Omitted: 800x560, minimum 360x240, no maximum, resizable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultWidth": { "type": "integer", "minimum": 1 },
        "defaultHeight": { "type": "integer", "minimum": 1 },
        "minWidth": { "type": "integer", "minimum": 1 },
        "minHeight": { "type": "integer", "minimum": 1 },
        "maxWidth": { "type": "integer", "minimum": 1 },
        "maxHeight": { "type": "integer", "minimum": 1 },
        "resizable": { "type": "boolean" },
        "rememberGeometry": { "description": "Whether the OS remembers the window size and maximized state, not its position (ADR 0116, ADR 0122). Omitted: true.", "type": "boolean" },
        "style": { "description": "Window frame (ADR 0234 §1): normal, tool (close only, not resizable by the user) or none (client area only, transparent). Omitted: normal.", "enum": ["normal", "tool", "none"] },
        "showIcon": { "description": "Whether the title bar shows the app icon (ADR 0234 §2). Omitted: true.", "type": "boolean" },
        "maximizeBox": { "description": "Whether the title bar shows Maximize (ADR 0234 §2). Omitted: true.", "type": "boolean" },
        "minimizeBox": { "description": "Whether the title bar shows Minimize (ADR 0234 §2). Omitted: true.", "type": "boolean" },
        "showInTaskbar": { "description": "Whether the window has a taskbar button; without one the user cannot minimize it (ADR 0234 §2). Omitted: true.", "type": "boolean" },
        "modal": { "description": "Whether a child window blocks the window that opened it (ADR 0234 §3); ignored on the main window. Omitted: false.", "type": "boolean" },
        "canChangeScreen": { "description": "Whether the user may send the window to another screen; off, it stays on its screen and opens on screen 1 (ADR 0263). Omitted: true.", "type": "boolean" }
      }
    },
    "execution": { "enum": ["mainThread", "pool", "dedicated", "web"] },
    "oomScoreAdj": {
      "description": "oom_score_adj the app's processes start with (ADR 0126): -1000 (never killed by the OOM killer) to 1000 (killed first). Negative values are reserved to system apps. Omitted: the OS default.",
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "web": {
      "description": "Web part of a web app (ADR 0073): the URLs the site answers on, published by the OS resolver (ADR 0074).",
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?/([^?#\\s]*/)?$" }
        },
        "blazor": {
          "description": "Root component of the site's interactive Blazor part (ADR 0084), in the entry-point assembly.",
          "type": "object",
          "additionalProperties": false,
          "required": ["assembly", "type"],
          "properties": {
            "assembly": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "terminal" } }
      },
      "then": { "required": ["terminal"] }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "web" } }
      },
      "then": { "required": ["web"] },
      "else": { "not": { "required": ["web"] } }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "window" } } }
      },
      "then": { "not": { "required": ["fileHandlers"] } }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "window" } } }
      },
      "then": { "not": { "required": ["window"] } }
    },
    {
      "description": "Only a feature provides services to other apps (ADR 0262 §1).",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "feature" } } }
      },
      "then": { "not": { "required": ["providedServices"] } }
    },
    {
      "description": "Only a feature provides a type of network drive (ADR 0282 §1).",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "feature" } } }
      },
      "then": { "not": { "required": ["driveProviders"] } }
    },
    {
      "description": "Only a feature declares permissions of its own (ADR 0246 §1).",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "feature" } } }
      },
      "then": { "not": { "anyOf": [{ "required": ["providedCapabilities"] }, { "required": ["capabilityPrefix"] }] } }
    },
    {
      "description": "Only a feature declares roles (ADR 0247 §1).",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "not": { "const": "feature" } } }
      },
      "then": { "not": { "required": ["roles"] } }
    },
    {
      "description": "A feature (ADR 0260) has no entry point of its own; every other kind has exactly one of entryPoint (legacy, single-platform) or platform (MOB-003, multi-platform). See doc/en/wasm/dev/old/mobile-interface-platform-plan.md §4.3.",
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "feature" } }
      },
      "then": {
        "not": { "anyOf": [{ "required": ["entryPoint"] }, { "required": ["platform"] }, { "required": ["parent"] }] }
      },
      "else": {
        "oneOf": [
          { "required": ["entryPoint"], "not": { "required": ["platform"] } },
          { "required": ["platform"], "not": { "required": ["entryPoint"] } }
        ]
      }
    }
  ],
  "$defs": {
    "httpsAddress": {
      "type": "string",
      "pattern": "^https://[^/@\\s]+(/\\S*)?$"
    },
    "driveOAuthClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId"],
      "properties": {
        "clientId": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" }
      }
    },
    "driveOAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationEndpoint", "tokenEndpoint"],
      "properties": {
        "authorizationEndpoint": { "$ref": "#/$defs/httpsAddress" },
        "tokenEndpoint": { "$ref": "#/$defs/httpsAddress" },
        "revocationEndpoint": { "$ref": "#/$defs/httpsAddress" },
        "fullAccess": { "$ref": "#/$defs/driveOAuthClient" },
        "appFolder": { "$ref": "#/$defs/driveOAuthClient" },
        "appFolderPath": { "type": "string" },
        "extraAuthorizationParameters": { "type": "object", "additionalProperties": { "type": "string" } },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "idPath"],
          "properties": {
            "address": { "$ref": "#/$defs/httpsAddress" },
            "idPath": { "type": "string", "minLength": 1 },
            "usePost": { "type": "boolean" },
            "namePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "anyOf": [{ "required": ["fullAccess"] }, { "required": ["appFolder"] }]
    },
    "driveFormField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "kind"],
      "properties": {
        "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["text", "url", "number", "choice"] },
        "secret": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "choices": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "serverAddress": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] }, "then": { "not": { "required": ["default"] } } },
        { "if": { "properties": { "serverAddress": { "const": true } }, "required": ["serverAddress"] }, "then": { "properties": { "kind": { "const": "url" }, "secret": { "const": false }, "required": { "const": true } } } },
        { "if": { "properties": { "kind": { "const": "choice" } } }, "then": { "required": ["choices"] }, "else": { "not": { "required": ["choices"] } } }
      ]
    },
    "platformId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
    },
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion"],
      "properties": {
        "minimumVersion": { "$ref": "#/$defs/semanticVersion" },
        "maximumVersion": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*://)[^\\\\?#]+$"
    },
    "resourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineCpuWeight",
        "burstCpuWeight",
        "baselineMemoryWeight",
        "burstMemoryWeight",
        "baselineStorageIoWeight",
        "burstStorageIoWeight",
        "baselineNetworkIoWeight",
        "burstNetworkIoWeight"
      ],
      "properties": {
        "baselineCpuWeight": { "$ref": "#/$defs/unitWeight" },
        "burstCpuWeight": { "$ref": "#/$defs/unitWeight" },
        "baselineMemoryWeight": { "$ref": "#/$defs/unitWeight" },
        "burstMemoryWeight": { "$ref": "#/$defs/unitWeight" },
        "baselineStorageIoWeight": { "$ref": "#/$defs/unitWeight" },
        "burstStorageIoWeight": { "$ref": "#/$defs/unitWeight" },
        "baselineNetworkIoWeight": { "$ref": "#/$defs/unitWeight" },
        "burstNetworkIoWeight": { "$ref": "#/$defs/unitWeight" }
      }
    },
    "unitWeight": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
