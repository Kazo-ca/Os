<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      ADR 0106 §4: the host that installs this Feature trims it when it publishes; the trim analysis
      reports here, at build, any reflection the trimmer could not follow.
    -->
    <IsTrimmable>true</IsTrimmable>
    <!-- A Kazo OS app (here a Feature); also read by the Debug profile of a kazoos-solution repository (ADR 0207). -->
    <KazoOsAppProject>true</KazoOsAppProject>
    <!-- One version for every Kazo OS package (ADR 0098 §1). -->
    <KazoOsVersion>0.0.0-dev</KazoOsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kazo.Os.AppSdk" Version="$(KazoOsVersion)" />
    <!-- Generates manifest.json after the build, checks the SDK boundary and the provider's class (KOSAPP0036). -->
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kazo.Os.Template.DriveProvider.Tests" />
  </ItemGroup>

</Project>
