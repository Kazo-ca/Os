<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build fixture (ADR 0244 §2). Not part of the solution. A contract library whose author marks it
    as shared: the property below writes the mark into the assembly, and KazoOsPack copies it to
    "shared" in the package of any app that references this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2.0</Version>
    <KazoOsSharedLibrary>true</KazoOsSharedLibrary>
  </PropertyGroup>
</Project>
