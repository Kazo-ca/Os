<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Library of the test package of ADR 0206, not part of the solution (ADR 0261 §1, issue #419):
    a ProjectReference of Kazo.Os.Fixtures.InstalledAssets with no dependency on the SDK. KazoOsPack
    puts it in lib/ and lists it in "libraries" of kazoos-package.json; the trimmed OS loads it
    before the app's own assembly. Its name is outside Kazo.Os.*, which the OS reserves.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
