<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR 0282 (series drive-providers, work item 9): a third-party Feature compiled once against the
    Kazo OS 3.5.0 packages, the first SDK with network drive providers. It declares a drive type with
    a form connection and implements KazoDriveProvider and KazoDriveFolder over a service kept in
    memory (no network). Its package, kept in ../../packages, is loaded by the current OS in the
    compatibility tests, which run the public conformance suite against it; it is never rebuilt
    against a newer SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Contoso.Sdk35DriveProvider</PackageId>
    <Version>$(KazoOsVersion)</Version>
    <Authors>Contoso</Authors>
    <Description>Kazo OS SDK compatibility fixture: a Feature that provides a network drive type, compiled against SDK $(KazoOsVersion).</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KazoOsSdkCompiledAgainst" Value="$(KazoOsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kazo.Os.AppSdk" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
